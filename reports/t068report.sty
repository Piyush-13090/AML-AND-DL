% Plain report style for Team T068 (single column, Times-like 12 pt, IEEE-style references)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{t068report}[2026/10/20 Team T068 report style]

\RequirePackage[a4paper,margin=2.54cm]{geometry}
\RequirePackage{amsmath,amsthm}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{texgyretermes}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]
\setmathfont{texgyretermes-math.otf}
\newcommand{\bm}[1]{\symbf{#1}}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage[section]{placeins}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{cite}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{setspace}

% text layout: like a word processor (1.15 line spacing, space between paragraphs, no indent)
\setstretch{1.15}
\setlength{\parskip}{6pt}
\setlength{\parindent}{0pt}
\setlist{itemsep=2pt,topsep=3pt}
\setlength{\emergencystretch}{2em}
\graphicspath{{../../figures/}}

% headings: plain bold, black
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

% captions and tables
\captionsetup{font=small,labelfont=bf,labelsep=colon}
\captionsetup[table]{position=top,skip=4pt}
\renewcommand{\arraystretch}{1.15}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}   % left-aligned text in table columns

% page numbers only
\pagestyle{plain}

